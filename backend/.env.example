# Server Configuration
PORT=5000

# MongoDB Connection String (Atlas URI or local mongodb://127.0.0.1:27017/blogify)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourmongodb.net/blogify?retryWrites=true&w=majority

# JWT Authentication Secret & Token Expiry
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1d

# Allowed Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://127.0.0.1:5500
